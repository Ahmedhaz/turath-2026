{
  "appId": "com.turath2026.app",
  "appName": "Turath2026",
  "webDir": "www",
  "backgroundColor": "#F5EFE3",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F5EFE3",
    "scrollEnabled": true
  },
  "android": {
    "backgroundColor": "#F5EFE3",
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#F5EFE3"
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#F5EFE3",
      "showSpinner": false,
      "launchFadeOutDuration": 250
    }
  }
}
